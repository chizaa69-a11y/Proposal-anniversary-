<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Propose Day ❤️</title>

<style>

/* GENERAL */
body{
margin:0;
font-family:'Segoe UI',sans-serif;
overflow-x:hidden;
}

/* PAGE SYSTEM */
.page{
display:none;
height:100vh;
width:100%;
justify-content:center;
align-items:center;
flex-direction:column;
}

.active{
display:flex;
}

/* ---------- PAGE 1 ---------- */

#page1{
background:#000;
color:white;
text-align:center;
}

/* HEART */
.heart{
width:120px;
height:120px;
background:#ff4d6d;
position:relative;
transform:rotate(-45deg);
animation:pulse 1.5s infinite;
margin-bottom:40px;
}

.heart:before,
.heart:after{
content:"";
width:120px;
height:120px;
background:#ff4d6d;
border-radius:50%;
position:absolute;
}

.heart:before{
top:-60px;
left:0;
}

.heart:after{
left:60px;
top:0;
}

@keyframes pulse{
0%{transform:rotate(-45deg) scale(1);}
50%{transform:rotate(-45deg) scale(1.2);}
100%{transform:rotate(-45deg) scale(1);}
}

/* MESSAGE */
.message{
font-size:2rem;
margin-bottom:30px;
}

/* BUTTON */
.propose-btn{
padding:15px 35px;
font-size:18px;
border:none;
border-radius:40px;
background:#ff4d6d;
color:white;
cursor:pointer;
animation:buttonPulse 2s infinite;
transition:all .3s ease;
}

.propose-btn:hover{
background:#ff1f4d;
transform:scale(1.1);
}

@keyframes buttonPulse{
0%{box-shadow:0 0 0 0 rgba(255,77,109,.7);}
70%{box-shadow:0 0 0 20px rgba(255,77,109,0);}
100%{box-shadow:0 0 0 0 rgba(255,77,109,0);}
}

/* CONFETTI */
.confetti{
position:fixed;
width:10px;
height:10px;
top:0;
opacity:0.8;
animation:fall 3s linear forwards;
}

@keyframes fall{
to{
transform:translateY(100vh) rotate(360deg);
opacity:0;
}
}

/* ---------- PAGE 2 ---------- */

#page2{
background:#ffe4ec;
padding:20px;
}

.card{
max-width:900px;
width:100%;
background:white;
display:flex;
flex-wrap:wrap;
border-radius:15px;
overflow:hidden;
box-shadow:0 10px 25px rgba(0,0,0,0.15);
animation:fadeIn 2s ease;
}

.card img{
width:100%;
height:100%;
object-fit:cover;
}

.left{
flex:1;
min-width:250px;
}

.right{
flex:1;
padding:40px;
display:flex;
flex-direction:column;
justify-content:center;
}

.love-note{
font-size:20px;
color:#444;
margin-bottom:30px;
animation:fadeInText 3s ease;
}

@keyframes fadeInText{
from{opacity:0;transform:translateY(20px);}
to{opacity:1;transform:translateY(0);}
}

/* LOVE LETTER */

.letter{
background:#fff0f5;
padding:20px;
border-radius:10px;
}

textarea{
width:100%;
height:150px;
border:none;
outline:none;
resize:none;
font-size:16px;
background:transparent;
}

@keyframes fadeIn{
from{opacity:0}
to{opacity:1}
}

/* MOBILE */

@media(max-width:768px){
.card{
flex-direction:column;
}
}

</style>
</head>

<body>

<!-- PAGE 1 -->

<div id="page1" class="page active">

<div class="heart"></div>

<div class="message">
Will you be mine forever? ❤️
</div>

<button class="propose-btn" onclick="acceptLove()">
Yes, of course!
</button>

</div>


<!-- PAGE 2 -->

<div id="page2" class="page">

<div class="card">

<div class="left">
<img src="https://share.google/images/RLledY1sqZwYxDiLY">
</div>

<div class="right">

<div class="love-note">
Meeting you was fate, becoming your friend was a choice, but falling in love with you was beyond my control 💓💋
</div>

<div class="letter">
<h3>My Love Letter 💌</h3>
<textarea placeholder="Write your heartfelt emotions here..."></textarea>
</div>

</div>

</div>

</div>


<script>

/* PAGE CHANGE */

function acceptLove(){

createConfetti()

setTimeout(()=>{
document.getElementById("page1").classList.remove("active")
document.getElementById("page2").classList.add("active")
},1200)

}

/* CONFETTI */

function createConfetti(){

for(let i=0;i<80;i++){

let conf=document.createElement("div")
conf.classList.add("confetti")

conf.style.left=Math.random()*100+"vw"

conf.style.background=
`hsl(${Math.random()*360},100%,60%)`

conf.style.animationDuration=
(2+Math.random()*2)+"s"

document.body.appendChild(conf)

setTimeout(()=>{
conf.remove()
},4000)

}

}

</script>

</body>
</html>
